# Copie este archivo como .env.local y complete los valores. .env.local nunca se sube al repositorio.

# Clave para cargar series en /datos (curvas FRAC, IPC, expectativas, IBR 12M, TES). Mínimo 8 caracteres.
ADMIN_KEY=

# Secreto que Vercel Cron envía al refrescar los datos de mercado (lo crea Vercel al configurar el cron).
CRON_SECRET=

# Token de Vercel Blob para guardar las cargas en producción (en local se guardan en data/cargas/).
BLOB_READ_WRITE_TOKEN=

# Asesor IA: clave de la API de Anthropic (console.anthropic.com → API Keys). Solo la usa el servidor.
ANTHROPIC_API_KEY=

# Opcional: modelo y nivel de esfuerzo del asesor (por defecto claude-opus-5-5 y medium).
# Esfuerzo: low | medium | high | xhigh | max. Más esfuerzo = respuestas más elaboradas y más costo.
ASESOR_MODELO=
ASESOR_ESFUERZO=

# Opcional (recomendado en Vercel): Upstash Redis para que el límite de 20 consultas/hora por IP
# sea el mismo en todas las instancias. Sin esto se cuenta en la memoria de cada instancia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
